{
  "name": "dsh-plugin-btw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: /btw asks a side question in a right-sidebar thread without touching the main conversation.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/btw.js && node --check src/label.js && node --check src/threads.js && node --check client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
